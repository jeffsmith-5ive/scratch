{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      ".firebaserc",
      "Dockerfile",
      "index.php",
      "app/**",
      "**/.*"
    ],
    "rewrites": [
      {
        "source": "**",
        "run": {
          "serviceId": "jeff-brewery",
          "region": "us-central1"
        }
      }
    ]
  }
}
